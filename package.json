  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test-db": "tsx scratch/test-db.ts",
    "test-sync": "tsx scratch/test-sync.ts"
  },
  "keywords": [
    "mcp",
    "okr",
    "firebase",
    "firestore",
    "google-cloud",
